# Configuración del Servidor
PORT=4000

# ============================================================
# CONEXIÓN A MYSQL
# Completa UNA de las dos opciones (recomendado: DATABASE_URL)
# ============================================================

# Opción A (recomendada): connection string completa de MySQL
DATABASE_URL=mysql://usuario:password@localhost:3306/agendaactybien

# Opción B: variables individuales (se usan solo si DATABASE_URL está vacío)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=tu_password
# DB_NAME=agendaactybien

# Seguridad JWT
JWT_SECRET=tu_secreto_jwt_aqui_cambialo_en_produccion
JWT_EXPIRES_IN=24h

# Orígenes CORS adicionales (separados por coma si aplica)
CORS_ORIGINS=https://tudominio.com,http://localhost:5500
