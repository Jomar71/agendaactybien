# Configuración del Servidor
PORT=4000
NODE_ENV=development

# Configuración de la Base de Datos
# Opción A: connection string completa (recomendada)
DATABASE_URL=postgresql://usuario:password@host:puerto/base_de_datos
DB_SSL=true

# Opción B: variables individuales (alternativa a DATABASE_URL)
# DB_USER=admin_proyectos
# DB_PASSWORD=admin123
# DB_HOST=localhost
# DB_NAME=spa_unas_db
# DB_PORT=5432

# Seguridad JWT
JWT_SECRET=actitud_y_bienestar_secure_jwt_secret_2026
JWT_EXPIRES_IN=24h

# Orígenes CORS adicionales (separados por coma si aplica)
CORS_ORIGINS=https://agendaactybien.pxxl.click,http://localhost:5500
